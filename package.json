{
  "name": "@1claw/muse-connector",
  "version": "0.1.0",
  "description": "1Claw connector for Meta Muse: a curated, per-user REST surface (approvals, portfolio, agents) that Muse can drive as a Custom Connector, backed by the 1Claw Platform API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "bin": { "1claw-muse-connector": "dist/index.js" },
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "connector"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:prod": "node scripts/e2e-prod.mjs"
  },
  "dependencies": {
    "@1claw/sdk": "^0.61.23",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "repository": { "type": "git", "url": "https://github.com/1clawAI/muse-connector.git" },
  "homepage": "https://docs.1claw.co/docs/integrations/muse",
  "keywords": ["1claw", "muse", "meta", "connector", "approvals", "agents"]
}
